          "name": "Resolve a runtime download URL",
          "request": {
            "name": "Resolve a runtime download URL",
            "description": {
              "content": "Resolves a runtime limulator download URL into the internal download bundle shape.\nURLs that point at Limrun-owned asset-storage buckets may be upgraded to a\nheader-signed TAG request with the original URL as fallback, but only after\nthe original URL successfully authorizes a one-byte probe. Other URLs are\nreturned unchanged. Possession of the source URL is the authorization\ncapability for this endpoint.\n",
              "type": "text/plain"
            },
